<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutChip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chip_inactive"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivCompetitionLogo"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/content_desc_logo"
        tools:src="@drawable/ic_logo_footlytics" />

    <TextView
        android:id="@+id/tvCompetitionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#17202A"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="LaLiga" />

</LinearLayout>
